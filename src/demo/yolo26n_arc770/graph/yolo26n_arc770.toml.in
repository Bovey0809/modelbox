[driver]
dir = [
    "@DEMO_YOLO26N_ARC770_FLOWUNIT_DIR@"
]
[flow]
desc = "YOLO26n object detection on Intel Arc via OpenVINO"
[graph]
format = "graphviz"
graphconf = """digraph yolo26n_arc770 {
    node [shape=Mrecord]
    video_input[type=flowunit, flowunit=video_input, device=cpu, deviceid=0, source_url="@DEMO_VIDEO_DIR@/yolo26n_test_video.mp4"]
    videodemuxer[type=flowunit, flowunit=video_demuxer, device=cpu, deviceid=0]
    videodecoder[type=flowunit, flowunit=video_decoder, device=intel_gpu, deviceid=0, pix_fmt=bgr]
    image_resize[type=flowunit, flowunit=resize, device=cpu, deviceid=0, image_width=640, image_height=640]
    image_transpose[type=flowunit, flowunit=packed_planar_transpose, device=cpu, deviceid=0]
    normalize[type=flowunit, flowunit=normalize, device=cpu, deviceid=0, standard_deviation_inverse="0.00392156862745098,0.00392156862745098,0.00392156862745098"]
    yolo26_detect[type=flowunit, flowunit=yolo26_detect, device=intel_gpu, deviceid=0, batch_size=1]
    yolo26_post[type=flowunit, flowunit=yolo26_post, device=cpu, deviceid=0, conf_threshold=0.35]
    videoencoder[type=flowunit, flowunit=video_encoder, device=intel_gpu, deviceid=0, encoder=h264_qsv, format=mp4, default_dest_url="/tmp/yolo26n_arc770_result.mp4"]

    video_input:out_video_url -> videodemuxer:in_video_url
    videodemuxer:out_video_packet -> videodecoder:in_video_packet
    videodecoder:out_video_frame -> image_resize:in_image
    image_resize:out_image -> image_transpose:in_image
    image_transpose:out_image -> normalize:in_data
    normalize:out_data -> yolo26_detect:input
    yolo26_detect:output -> yolo26_post:in_feat
    videodecoder:out_video_frame -> yolo26_post:in_image
    yolo26_post:out_data -> videoencoder:in_video_frame
}"""
