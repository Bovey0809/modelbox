[driver]
dir = [
    "@DEMO_SUTRACK_FLOWUNIT_DIR@"
]
[flow]
name = "SUTrack"
desc = "SUTrack single-object tracker. POST {video_path, init_bbox:[x,y,w,h]} to start a track; the flowunit hosts the upstream SUTrack PyTorch tracker (sutrack_b224, no-text) and returns the bbox trajectory."
[graph]
format = "graphviz"
graphconf = '''digraph sutrack {
    node [shape=Mrecord]
    httpserver_sync_receive[type=flowunit, flowunit=httpserver_sync_receive, device=cpu, time_out_ms=600000, endpoint="http://0.0.0.0:7781", max_requests=2]
    sutrack_track[type=flowunit, flowunit=sutrack_track, device=cpu]
    httpserver_sync_reply[type=flowunit, flowunit=httpserver_sync_reply, device=cpu]

    httpserver_sync_receive:out_request_info -> sutrack_track:in_data
    sutrack_track:out_data -> httpserver_sync_reply:in_reply_info
}
'''
